<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/output.css">
    <title>Dropdown Menu</title>
</head>
<div class="flex h-screen justify-center items-center">
<div class="bg-white p-4 rounded shadow-md w-1/2">
<body style="text-align: center; background-color: rgb(18, 44, 128)">
    <form action="/views/showTrains" method="GET">
        <h1 class="font-bold" style="font-size: 20px;">Select a Departure</h1>
        <select required name="dropdown1" id="dropdown1" class="bg-dark bg-blue-800 hover:bg-blue-900 text-white font-bold py-2 px-4 rounded ">
            <option disabled selected value> -- select an option -- </option>
        </select>
        <br><br>
        <h1 class="font-bold" style="font-size: 20px;">Select a Destination</h1>
        <select required name="dropdown2" id="dropdown2" class="bg-dark bg-blue-800 hover:bg-blue-900 text-white font-bold py-2 px-4 rounded ">
            <option disabled selected value> -- select an option -- </option>

        </select>
        <script>
            async function getStationName(num) {
                try {
                    const response = await fetch('/api/data');
                    const data = await response.json();
                    populateDropdown(data, num);
                } catch (error) {
                    console.error('Error fetching data:', error);
                }
            }

            function populateDropdown(data, num) {
                const dropdown = document.getElementById('dropdown'+num);
                data.forEach(item => {
                    const option = document.createElement('option');
                    option.value = item.name; 
                    option.textContent = item.name; 
                    dropdown.appendChild(option);
                });
            }

            getStationName('1');
            getStationName('2');
            dropdown1.addEventListener('change', function() { 
                for (let i = 0; i < dropdown2.options.length; i++) {
                    dropdown2.options[i].disabled = false;
                }
                const selectedValue = this.value;
                var optionToDisable = dropdown2.querySelector(`option[value="${selectedValue}"]`); 
                optionToDisable.disabled = true;
            });  
        </script>
        <br> 
        <br>
        <input type="submit" value="Find Trains" class="bg-dark bg-blue-800 hover:bg-blue-900 text-white font-bold py-2 px-4 rounded " >
    </form>    
</body>
</div>
</div>
</html>
